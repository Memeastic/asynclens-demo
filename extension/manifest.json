{
  "manifest_version": 3,
  "name": "AsyncLens Simple",
  "version": "0.1.0",
  "description": "Self-contained AsyncLens demo extension — no external server required. Load unpacked and open Options to view events.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["instrumentation.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-injector.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "AsyncLens Simple"
  }
}
