{
  "manifest_version": 3,
  "name": "AsyncLens Injector",
  "description": "Inject AsyncLens instrumentation into web pages and send events to a local AsyncLens collector.",
  "version": "0.2.0",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["instrumentation.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-injector.js"],
      "run_at": "document_start"
    }
  ]
}
