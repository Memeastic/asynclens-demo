{
  "manifest_version": 3,
  "name": "AsyncLens Injector",
  "description": "Inject AsyncLens instrumentation into web pages and send events to a local AsyncLens collector.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "icons": { "48": "icons/icon48.png" },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-injector.js"],
      "run_at": "document_start"
    }
  ]
}
